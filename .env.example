# Project Settings
API_V1_STR=/api/v1
DEBUG=True

# Database
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mentorship_db

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Taskiq Configurations
TASKIQ_DASHBOARD_TOKEN=supersecret
TASKIQ_DASHBOARD_PATH=/admin
TASKIQ_DASHBOARD_URL=http://localhost:8000/admin
TASKIQ_WORKER_RELOAD=True

# JWT Settings
JWT_SECRET_KEY=your_super_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_telegram_bot_username_here

# Initial Superuser Settings
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=adminpassword

# Auth Redis
REDIS_AUTH_URL=redis://redis:6379/1

# Rate Limiting & Grace Period
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
REFRESH_GRACE_PERIOD_SECONDS=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Apify Settings
BASE_URL=http://localhost:8000
APIFY_API_TOKEN=your_token_here
APIFY_WEBHOOK_SECRET=your_secret_here
APIFY_ACTOR_ID=automation-lab~airbnb-listing
APIFY_MAX_LISTINGS=10  # local/MVP; set to 50+ in production
APIFY_POLL_INTERVAL_MINUTES=360  # how often the scheduler runs (360=6h; use 10 for local testing)
APIFY_POLL_BATCH_SIZE=50  # subscriptions dispatched per scheduler run
APIFY_SUBSCRIPTION_RECHECK_HOURS=24  # min hours before a subscription is eligible for re-check

# MCP Admin Settings
MCP_API_KEY=your-mcp-api-key-here
